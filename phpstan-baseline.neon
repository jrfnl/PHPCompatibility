parameters:
	ignoreErrors:
		-
			message: "#^Property PHPCompatibility\\\\Sniffs\\\\Extensions\\\\RemovedExtensionsSniff\\:\\:\\$functionWhitelist \\(array\\) in isset\\(\\) is not nullable\\.$#"
			count: 1
			path: PHPCompatibility/Sniffs/Extensions/RemovedExtensionsSniff.php

		-
			message: "#^Strict comparison using \\=\\=\\= between true and false will always evaluate to false\\.$#"
			count: 1
			path: PHPCompatibility/Sniffs/Extensions/RemovedExtensionsSniff.php

		-
			message: "#^Result of && is always false\\.$#"
			count: 2
			path: PHPCompatibility/Sniffs/Operators/ChangedConcatOperatorPrecedenceSniff.php

		-
			message: "#^Strict comparison using \\=\\=\\= between mixed and 'PHPCS_T_OPEN_CURLY…' will always evaluate to false\\.$#"
			count: 1
			path: PHPCompatibility/Sniffs/Operators/ChangedConcatOperatorPrecedenceSniff.php

		-
			message: "#^Unreachable statement \\- code above always terminates\\.$#"
			count: 2
			path: PHPCompatibility/Tests/BaseSniffTestCase.php
